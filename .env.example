# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chainmind?retryWrites=true&w=majority

# AI Service API Keys (Do not expose in production)
AI_API_KEY=your_openai_or_anthropic_api_key

# Blockchain / Web3 Settings
RPC_URL=https://rpc-amoy.polygon.technology/
PRIVATE_KEY=your_wallet_private_key_here
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# IPFS Integration
IPFS_API_KEY=your_pinata_api_key
IPFS_SECRET_KEY=your_pinata_secret_key
